# Backend settings. Copy to .env and fill in.

# URLs
BASE_URL=http://127.0.0.1:5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false

# Upload and processing limits
MAX_CONTENT_LENGTH_MB=100
MAX_DISK_USAGE_MB=1000
MAX_JOBS_PER_IP=2
MAX_UPLOADS_PER_MIN=5
JOB_EXPIRATION=300
TEMP_DIR=temp
LOG_FILE=logs/app.log

# Optional: path to the demucs executable (defaults to the one in your venv)
DEMUCS_BIN=

# Email (SMTP over SSL) for verification and password reset
MAIL_SERVER=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Stripe (use test mode keys)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Admin endpoint token
ADMIN_TOKEN=
